# sf-towing — copy from findmycar Vercel project
NEXT_PUBLIC_TOWING_SUPABASE_URL=
NEXT_PUBLIC_TOWING_SUPABASE_ANON_KEY=

# internet-airport — copy from domains-today Vercel project
NEXT_PUBLIC_AIRPORT_SUPABASE_URL=
NEXT_PUBLIC_AIRPORT_SUPABASE_ANON_KEY=

# Apple Maps (same as findmycar — used by sf-towing and sf-meters)
APPLE_MAPS_TEAM_ID=
APPLE_MAPS_KEY_ID=
APPLE_MAPS_PRIVATE_KEY=

# sf-meters — copy from your sf-meters Supabase project
NEXT_PUBLIC_METERS_SUPABASE_URL=
NEXT_PUBLIC_METERS_SUPABASE_ANON_KEY=
# DATASF_APP_TOKEN= (optional — higher DataSF rate limits)

# sf-muni — 511 SF Bay API token(s) from https://511.org/open-data/token
# Comma-separate multiple keys to refresh faster (route round-robins them).
# 1 key → 120s refresh, 2+ keys → 60s. Override with API_511_REFRESH (seconds).
API_511_KEYS=
# API_511_REFRESH= (optional — seconds between refreshes)
